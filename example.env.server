G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
# 采集守护进程（定时抓取各信源并落库，见 server/collector/）
# COLLECT_ENABLED=false        关掉采集；默认开（node-server / bun 预设下每分钟一次心跳，只抓到期的源）
# COLLECT_SOURCES=jin10,hackernews   只采这几个源（逗号分隔）；不设则采全部
# COLLECT_CONCURRENCY=8        同时在抓的源数上限
# COLLECT_RETENTION_DAYS=7     observations 保留天数（items 永久）
# COLLECT_MAX_ITEMS=200        单个源一次最多记多少条
# COLLECT_TIMEOUT_MS=60000     单个源一次抓取的总超时
# 用户订阅源（运行时增删改，见 server/registry/；接口 /api/collector/sources 只给本机）
# USER_SOURCES_ALLOW_PRIVATE=true   允许用户源指向内网 / 回环地址（自建 RSSHub、内网 JSON 服务）；默认拒绝
# USER_SOURCES_MAX_BYTES=5242880    用户源单次响应体上限，默认 5 MiB
# USER_SOURCES_TOKEN=             非本机访问用户源接口的令牌（docker 里宿主机访问容器时对端不是回环）。
#                                 不设就只允许本机（对端回环 + Host/Origin 白名单）。设了以后，带
#                                 `Authorization: Bearer <令牌>` 的请求不再受「本机」限制，所以：请用 32 位以上的随机串，
#                                 只在受信任的网络里暴露端口；令牌泄露等于任何能连上端口的人都能增删改用户源，
#                                 并让服务器去抓他指定的地址（SSRF 防护仍然生效）。
# 预置订阅包（server/registry/presets/feeds.json，路透 / 美联社 / 彭博 / TechCrunch / arXiv / Reddit / YouTube 等，默认全部不启用）：
#   GET /api/collector/presets 看列表与状态；PATCH /api/collector/presets/<slug> 带 {"enabled":true|false} 启用 / 停用；
#   GET /api/collector/presets/opml 导出 OPML（可导入别的阅读器，或经 POST /api/collector/sources/opml 导入成停用的用户源）。启用后就是普通用户源 user:<slug>。
#   刚启用的源要等下一轮采集（至多 1 分钟）才有观测，这之前 `pnpm collector:check` 会因为「没有观测」非零退出，不是故障。
# 注意：COLLECT_SOURCES 设了之后只采列出的源，用户源（user:<slug>）也要列进去
# 新闻流与 MCP（server/feed/、server/mcp/、server/actions/；接口形状见 PR #2186）
# GET /api/feed、GET /api/feed/stream（SSE）、POST /mcp（MCP，Streamable HTTP，无状态）、GET /api/collector/audit、
# POST /api/collector/audit/:id/undo 的访问控制与用户源接口完全相同：只给本机，或带 USER_SOURCES_TOKEN 的 Bearer 令牌。
# 请求头 X-Actor（可选，ASCII，最长 64）写进审计，用来区分是哪个 agent 或页面调用的；它不是身份认证。
# 富化（server/enrich/，#2188）：入库后同步给新条目做标题清洗、标的识别（A 股 / 美股 / 加密币）与去重合并
# ENRICH_ENABLED=false         关掉富化；默认开。关了以后新条目 enriched = 0，之后开回来用 pnpm enrich:backfill 补
# 历史条目回填：先停服务，再 `pnpm enrich:backfill [--db 路径]`；词典更新后 `pnpm enrich:backfill --symbols` 只重算标的
# 词典重新生成：`pnpm enrich:dict`（A 股取新浪行情、美股取 SEC / Nasdaq 公开名单、加密币取公开市值榜，来源与日期写在脚本头）
# 规则层与对齐交易日（#2188 补充）：规则层和对齐不要钱、不要模型；升级后老数据用 `pnpm enrich:backfill --rules`（加 --all 全部重算）补，不用停服务
# ENRICH_CONFIG_DIR=/path        覆盖内置配置的目录，里面放同名文件：calendar.json（休市日历，来源与读取日期写在文件里）、
#                                 impact-types.json（各市场的影响类型表）、source-markets.json（信源 → 默认市场）。
#                                 文件不合法就退回内置并告警，不会让服务起不来。
# 批量标注层（便宜模型，每组主条目标注 impact / direction / gist / themes）。不配就跳过：字段为 null，不报错、不编造。
# ENRICH_LLM_PROVIDER=openai     openai（任何 OpenAI 兼容的 /chat/completions）或 anthropic
# ENRICH_LLM_API_KEY=            密钥；没有默认模型，下面三项缺一不可
# ENRICH_LLM_MODEL=
# ENRICH_LLM_BASE_URL=           openai 兼容服务的地址（到 /v1 为止）；anthropic 可不填
# ENRICH_TAG_CATEGORIES=finance,财经   哪些信源分类进批量标注；* = 全部。带标的的条目不论分类都会标
# ENRICH_TAG_MAX_BATCHES=2       每轮采集后最多发几批（每批至多 40 条）；失败 5 分钟后再试，同一条最多试 3 次
# 手动：`pnpm enrich:tag --status` 看进度，`--redo` 重标。标注只是新闻的解读，direction 不是涨跌预测。
# 按需深读层（GET /api/feed/deep?seq= 或 MCP read_item_deep；结果按 seq 缓存在库里，第二次读缓存）
# ENRICH_DEEP_LLM_PROVIDER / _API_KEY / _MODEL / _BASE_URL   深读用的模型；不设就沿用 ENRICH_LLM_*
# ENRICH_DEEP_FETCH_PAGE=false   不去取原文页面，只按标题深读（默认会尽力取，走 SSRF 防护）
# 标注准确率评估：`pnpm enrich:tag-eval --sample 100 --out gold.json` 抽样 → 人工填 impact / direction → `--score gold.json`
