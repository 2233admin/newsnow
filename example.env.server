G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
# 采集守护进程（定时抓取各信源并落库，见 server/collector/）
# COLLECT_ENABLED=false        关掉采集；默认开（node-server / bun 预设下每分钟一次心跳，只抓到期的源）
# COLLECT_SOURCES=jin10,hackernews   只采这几个源（逗号分隔）；不设则采全部
# COLLECT_CONCURRENCY=8        同时在抓的源数上限
# COLLECT_RETENTION_DAYS=7     observations 保留天数（items 永久）
# COLLECT_MAX_ITEMS=200        单个源一次最多记多少条
# COLLECT_TIMEOUT_MS=60000     单个源一次抓取的总超时
# 用户订阅源（运行时增删改，见 server/registry/；接口 /api/collector/sources 只给本机）
# USER_SOURCES_ALLOW_PRIVATE=true   允许用户源指向内网 / 回环地址（自建 RSSHub、内网 JSON 服务）；默认拒绝
# USER_SOURCES_MAX_BYTES=5242880    用户源单次响应体上限，默认 5 MiB
# USER_SOURCES_TOKEN=             非本机访问用户源接口的令牌（docker 里宿主机访问容器时对端不是回环）。
#                                 不设就只允许本机（对端回环 + Host/Origin 白名单）。设了以后，带
#                                 `Authorization: Bearer <令牌>` 的请求不再受「本机」限制，所以：请用 32 位以上的随机串，
#                                 只在受信任的网络里暴露端口；令牌泄露等于任何能连上端口的人都能增删改用户源，
#                                 并让服务器去抓他指定的地址（SSRF 防护仍然生效）。
# 预置订阅包（server/registry/presets/feeds.json，路透 / 美联社 / 彭博 / TechCrunch / arXiv / Reddit / YouTube 等，默认全部不启用）：
#   GET /api/collector/presets 看列表与状态；PATCH /api/collector/presets/<slug> 带 {"enabled":true|false} 启用 / 停用；
#   GET /api/collector/presets/opml 导出 OPML（可导入别的阅读器，或经 POST /api/collector/sources/opml 导入成停用的用户源）。启用后就是普通用户源 user:<slug>。
# 注意：COLLECT_SOURCES 设了之后只采列出的源，用户源（user:<slug>）也要列进去
